# ── Anthropic API ──────────────────────────────────────────────────────────
# Required for the update-topics CI script (GitHub Actions).
# Get yours at https://console.anthropic.com/settings/keys

# ── News API (live fetch via ISR) ───────────────────────────────────────────
# Required for CurrentTopicsServer to fetch live news every 3 days.
# Without this key the component renders the hardcoded FALLBACK_TOPICS silently.
#
# Provider options:
#   gnews   → https://gnews.io  (free: 100 req/day, articles from last 7 days)
#   newsapi → https://newsapi.org (free developer plan, articles from last 30 days)
#
NEWS_API_KEY=68215edb4cb3ca61af1be19f1d49c9d0
NEWS_API_PROVIDER=gnews
